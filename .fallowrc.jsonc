{
  // fallow: unused code, dependency hygiene, duplication and complexity.
  // `pnpm check:dead-code` gates the whole tree; `pnpm check:changes` gates only
  // findings a branch introduces. Existing complexity and clones are reported by
  // `pnpm report:quality`, not failed, until a refactor owns them.
  "$schema": "./node_modules/fallow/schema.json",
  "minimumVersion": "3.30.0",
  "framework": [
    {
      "name": "world-lab-coverage-tools",
      "enablers": ["ast-v8-to-istanbul"],
      "entryPoints": ["scripts/world-map/runtime-coverage-*.mjs"],
      "entryPointRole": "support",
      "toolingDependencies": ["ast-v8-to-istanbul", "istanbul-lib-coverage", "vite"],
    },
  ],
  // Manual browser probes are run by hand with Playwright, not imported.
  "entry": [
    "scripts/world-map/navigation-lab.ts",
    "scripts/world-map/navigation-lab.css",
    "scripts/world-map/world-lab.ts",
    "scripts/world-map/world-lab.css",
    "scripts/world-map/world-lab-server.ts",
    "scripts/world-map/world-lab-vite.config.ts",
    "apps/web/src/*.browser.mjs",
    // Approved static galleries are served through their HTML entry pages.
    "assets/art/combat/**/concepts.js",
    "assets/art/combat/**/concepts.css",
  ],
  "workspaces": {
    "patterns": ["apps/*", "packages/*"],
  },
  // Colyseus invokes Room lifecycle hooks and the message map by name.
  "usedClassMembers": [
    "onCreate",
    "onAuth",
    "onJoin",
    "onLeave",
    "onDrop",
    "onReconnect",
    "onDispose",
    "onBeforePatch",
    "onBeforeShutdown",
    "onCacheRoom",
    "onRestoreRoom",
    "messages",
  ],
  // Syntactic analysis misreads members reached through inferred instance types.
  "typeAware": { "enabled": true },
  "rules": {
    "unused-dependencies": "error",
    "unlisted-dependencies": "error",
    // Owned by scripts/check-architecture.mjs; one owner per boundary rule.
    "boundary-violation": "off",
    // Code-shape policies are owned by ast-grep (sgconfig.yml).
    "policy-violation": "off",
    // Exported signatures naming same-file types is not a current API requirement.
    "private-type-leaks": "off",
  },
  "health": {
    // Specification files are tables of scenarios inside describe callbacks.
    // The renderer spike is measurement tooling, not product code (PR #116).
    "ignore": ["**/*.test.ts", "**/*.test.tsx", "apps/renderer-spike/**"],
  },
}
