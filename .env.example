# Local development: `cp .env.example .env`, then `pnpm db:up`,
# `pnpm db:migrate:up` and `pnpm dev`. Loopback-only test values.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Pick a unique project name and unused ports for each concurrent checkout.
# COMPOSE_PROJECT_NAME=warwrit-my-checkout
POSTGRES_PORT=55432
DEX_PORT=5556
DEX_CONFIG_FILE=./fixtures/identity/dex.dev.yaml
DATABASE_URL=postgres://warwrit:warwrit@127.0.0.1:55432/warwrit
OIDC_ISSUER=http://127.0.0.1:5556/dex
OIDC_CLIENT_ID=warwrit-local
OIDC_CLIENT_SECRET=warwrit-local-only-secret
OIDC_REDIRECT_URI=http://127.0.0.1:5173/auth/callback
PUBLIC_ORIGIN=http://127.0.0.1:5173
WEB_PORT=5173
API_PROXY_TARGET=http://127.0.0.1:3000
ENCOUNTER_REALTIME_PORT=3110
ENCOUNTER_REALTIME_PROXY_TARGET=http://127.0.0.1:3110
VITE_API_BASE_URL=/api

# New ordinary companies use the painted world; existing env files without this keep legacy saves.
WORLD_MAP=painted-atlas
