{
  "name": "warwrit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.20.x",
    "pnpm": "11.25.x"
  },
  "scripts": {
    "agent:preflight": "bash scripts/agent-preflight.sh",
    "agent:status": "bash scripts/agent-status.sh",
    "bootstrap": "pnpm install --frozen-lockfile && pnpm verify",
    "build": "pnpm -r --if-present run build",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:changes": "fallow audit --coverage coverage/coverage-final.json",
    "check:dead-code": "fallow dead-code",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:patterns": "ast-grep scan && ast-grep test --skip-snapshot-tests",
    "clean": "node scripts/clean.mjs",
    "db:down": "docker compose down --remove-orphans",
    "db:migrate:down": "tsx --env-file-if-exists=.env apps/server/src/db/migrate.ts down",
    "db:migrate:status": "tsx --env-file-if-exists=.env apps/server/src/db/migrate.ts status",
    "db:migrate:up": "tsx --env-file-if-exists=.env apps/server/src/db/migrate.ts up",
    "db:up": "docker compose up -d --wait postgres dex",
    "dev": "pnpm --parallel --filter @warwrit/server --filter @warwrit/web run dev",
    "dev:map": "pnpm --filter @warwrit/game-core build && pnpm --filter @warwrit/web exec vite ../.. --host 127.0.0.1 --port 5326 --strictPort --open /scripts/world-map/navigation-lab.html",
    "dev:combat": "bash scripts/start-sprite-combat.sh",
    "dev:world": "bash scripts/start-world-lab.sh",
    "format": "prettier . --check",
    "format:write": "prettier . --write",
    "lint": "eslint .",
    "prepare": "sh scripts/install-git-hooks.sh",
    "report:quality": "fallow health --hotspots --targets && fallow dupes",
    "test": "pnpm test:unit",
    "test:map": "tsc -p scripts/world-map/tsconfig.json && vitest run scripts/world-map/navigation-lab.test.ts",
    "test:combat:stress": "tsx scripts/combat-stress.ts",
    "test:coverage": "vitest run --coverage --mode coverage",
    "test:migrations": "tsx scripts/run-migration-smoke.ts && vitest run --mode integration .integration.test.ts",
    "test:unit": "vitest run",
    "typecheck": "pnpm -r --if-present run typecheck",
    "validate:content": "node scripts/validate-content.mjs",
    "verify": "pnpm format && pnpm lint && pnpm check:architecture && pnpm check:dead-code && pnpm check:patterns && pnpm validate:content && pnpm build && pnpm typecheck && pnpm test:unit",
    "experiment:navigation": "tsx scripts/navigation-topology-experiment.ts"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.45.3",
    "@eslint/js": "^10.0.1",
    "@fastify/cookie": "11.1.2",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "@vitest/coverage-v8": "4.1.11",
    "@warwrit/game-core": "workspace:*",
    "@warwrit/protocol": "workspace:*",
    "@warwrit/testkit": "workspace:*",
    "ajv": "8.20.0",
    "ast-v8-to-istanbul": "1.0.7",
    "eslint": "^10.9.1",
    "fallow": "3.30.0",
    "globals": "^16.0.0",
    "istanbul-lib-coverage": "3.2.2",
    "jsdom": "27.4.0",
    "kysely": "^0.28.17",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "7.3.6",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@colyseus/sdk": "0.18.4",
    "pg": "^8.23.0"
  }
}
