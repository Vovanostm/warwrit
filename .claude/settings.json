{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(gh pr merge * --auto*)",
      "Bash(gh pr merge --auto*)",
      "Bash(gh pr merge * --admin*)",
      "Bash(gh pr merge --admin*)"
    ],
    "ask": [
      "Bash(gh pr merge *)",
      "Bash(git push *--force-with-lease*)",
      "Edit(apps/server/migrations/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/agent-preflight.sh\"; bash \"$CLAUDE_PROJECT_DIR/scripts/agent-status.sh\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/fallow-gate.sh"
          }
        ]
      }
    ]
  }
}
